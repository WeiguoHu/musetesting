    {
        "id": "2df4afbd07ea1c30",
        "type": "function",
        "z": "987aea556f99bc0c",
        "g": "41f5e6cfb1a4a777",
        "name": "FristCharMatch",
        "func": "// 假设输入字符串放在 msg.payload 里\nlet str = msg.payload;\n\n// 先做个基础判断，防止空值或者不是字符串\nif (typeof str === 'string' && str.length > 0) {\n    let firstChar = str.charAt(0).toUpperCase(); // 取首字母并转大写，防止大小写问题\n\n    if (firstChar === 'L' || firstChar === 'T') {\n        msg.match = true;  // 标记匹配成功\n    } else {\n        msg.match = false;\n    }\n} else {\n    msg.match = false;  // 非字符串或空串直接判为不匹配\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1260,
        "y": 1360,
        "wires": [
            [
                "7b562c5e73709775"
            ]
        ]
    },
    {
        "id": "7b562c5e73709775",
        "type": "switch",
        "z": "987aea556f99bc0c",
        "g": "41f5e6cfb1a4a777",
        "name": "",
        "property": "match",
        "propertyType": "msg",
        "rules": [
            {
                "t": "eq",
                "v": "true",
                "vt": "jsonata"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 1,
        "x": 1450,
        "y": 1360,
        "wires": [
            [
                "5fae9e1697dc258a"
            ]
        ]
    },
    {
        "id": "5fae9e1697dc258a",
        "type": "function",
        "z": "987aea556f99bc0c",
        "g": "41f5e6cfb1a4a777",
        "name": "twoPartInArray",
        "func": "let str = msg.payload;\n\nif (typeof str === 'string' && str.length > 0) {\n    let firstChar = str.charAt(0);        // 第一个字母\n    let rest = str.slice(1);              // 剩余字符串\n    msg.arr = [firstChar, rest];     // 装数组里\n} else {\n    // 如果不是字符串或者空字符串，给个空数组防止报错\n    msg.arr = [];\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1620,
        "y": 1360,
        "wires": [
            [
                "c0bb07e26ce2f24d"
            ]
        ]
    },
    {
        "id": "c0bb07e26ce2f24d",
        "type": "function",
        "z": "987aea556f99bc0c",
        "g": "41f5e6cfb1a4a777",
        "name": "composeArray",
        "func": "// 假设 msg.payload 是数组，比如 [\"N\", \"odeRED\"]\nlet arr = msg.arr;\n\nif (Array.isArray(arr) && arr.length >= 2) {\n    msg.payload = `<${arr[0]}&${arr[1]}>`;\n} else {\n    msg.payload = \"\"; // 不符合条件时给空字符串\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1820,
        "y": 1360,
        "wires": [
            [
                "7c7ea8dd45e9a305"
            ]
        ]
    },
    {
        "id": "e37f84d45a333556",
        "type": "change",
        "z": "987aea556f99bc0c",
        "g": "41f5e6cfb1a4a777",
        "name": "",
        "rules": [
            {
                "t": "set",
                "p": "currentControl",
                "pt": "global",
                "to": "arr",
                "tot": "msg"
            }
        ],
        "action": "",
        "property": "",
        "from": "",
        "to": "",
        "reg": false,
        "x": 1850,
        "y": 1520,
        "wires": [
            [
                "0987cbf8cf8fc75f"
            ]
        ]
    },
    {
        "id": "36e39fd28d67f63b",
        "type": "function",
        "z": "987aea556f99bc0c",
        "g": "f8a1bdabc4d4adae",
        "name": "veryControlType",
        "func": "// 假设 msg.payload 是数组，比如 [\"N\", \"odeRED\"]\nlet arr = global.get(\"currentControl\");\n\nif(arr[0].toUpperCase()===\"L\"){\n\nif (Array.isArray(arr) && arr.length >= 2) {\n    msg.front = `<${arr[0]}&${arr[1]}&`;\n} else {\n    msg.front = \"\"; // 不符合条件时给空字符串\n}\n\nreturn msg;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 920,
        "wires": [
            [
                "4a02e212ea19eda1"
            ]
        ]
    },
    {
        "id": "4a02e212ea19eda1",
        "type": "function",
        "z": "987aea556f99bc0c",
        "g": "f8a1bdabc4d4adae",
        "name": "addString",
        "func": "let first=msg.front;\nlet second=msg.payload;\nmsg.payload=first+second+\">\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 840,
        "y": 920,
        "wires": [
            [
                "9b197b052fefcd3f",
                "655fccf5ccb8afd6"
            ]
        ]
    },
