        "name": "splitString-number",
        "func": "let str = msg.payload;\nlet parts = str.split(\"&\"); // 按 & 分割\nif (parts.length >= 3) {\n    msg.number = parts[1]; // 截取第二部分\n} else {\n    msg.number = \"\";\n}\nreturn msg;",
        "outputs": 1,
