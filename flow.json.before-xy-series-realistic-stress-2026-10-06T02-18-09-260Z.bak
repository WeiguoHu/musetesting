        "name": "veryControlType",
        "func": "// 假设 msg.payload 是数组，比如 [\"N\", \"odeRED\"]\nlet arr = global.get(\"currentControl\");\n\nif(arr[0].toUpperCase()===\"L\" && msg.number ===arr[1]){\n\nif (Array.isArray(arr) && arr.length >= 2) {\n    msg.front = `<${arr[0]}&${arr[1]}&`;\n} else {\n    msg.front = \"\"; // 不符合条件时给空字符串\n}\nreturn msg;\n}",
        "outputs": 1,
        "timeout": 0,
