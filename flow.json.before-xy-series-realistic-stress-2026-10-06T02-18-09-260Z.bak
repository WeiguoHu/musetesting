    {
        "id": "ebadac673625a899",
        "type": "inject",
        "z": "78cb8aa58273455c",
        "name": "Synthetic max-point XY frames (10 Hz)",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "0.1",
        "crontab": "",
        "once": true,
        "onceDelay": 0.2,
        "topic": "",
        "payload": "",
        "payloadType": "date",
