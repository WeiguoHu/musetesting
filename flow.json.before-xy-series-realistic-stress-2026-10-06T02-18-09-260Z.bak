    {
        "id": "32fb3f3e80f518e4",
        "type": "function",
        "z": "78cb8aa58273455c",
        "name": "Generate 4 max-point spectra and map points",
        "func": "const sequence = Number(context.get('xySequence') || 0) + 1\ncontext.set('xySequence', sequence)\nconst sampleTime = Date.now()\nconst makeManifest = (streamId, xUnit, yUnit) => ({ kind: 'xy-series-manifest', streamId, epoch: 'local-' + streamId.replaceAll('/', '-'), layoutVersion: 1, publishHz: 10, clock: 'monotonic-ms', maxPoints: 8192, xUnit, yUnit })\nconst makeSpectrum = phase => Array.from({ length: 8192 }, (_, index) => {\n  const frequency = 20 * Math.pow(1000, index / 8191)\n  const level = -46 + 18 * Math.sin(index / 260 + phase) + 9 * Math.sin(index / 73 + phase * 1.7)\n  return [frequency, level]\n})\nconst makeFrame = (streamId, points) => ({ kind: 'xy-series-frame', streamId, epoch: 'local-' + streamId.replaceAll('/', '-'), layoutVersion: 1, seq: sequence, sampleTime, points })\nconst message = (kind, path, streamId, payload) => ({ kind, device: 'Meter Validation', path, streamId, payload })\nconst spectra = ['a', 'b', 'c', 'd'].map((letter, index) => {\n  const streamId = 'validation/spectrum-' + letter\n  return { streamId, manifest: makeManifest(streamId, 'Hz', 'dB'), frame: makeFrame(streamId, makeSpectrum(sequence / 20 + index)) }\n})\nconst coordinateStream = 'validation/coordinates'\nconst coordinates = [[116.368 + Math.sin(sequence / 16) * .014, 39.912 + Math.cos(sequence / 19) * .012], [116.405 + Math.sin(sequence / 21) * .011, 39.925 + Math.cos(sequence / 16) * .014], [116.432 + Math.sin(sequence / 18) * .009, 39.895 + Math.cos(sequence / 23) * .01], [116.389 + Math.sin(sequence / 25) * .013, 39.878 + Math.cos(sequence / 14) * .009]]\nconst coordinateManifest = { ...makeManifest(coordinateStream, 'longitude', 'latitude'), maxPoints: 16 }\nconst coordinateFrame = { ...makeFrame(coordinateStream, coordinates) }\nreturn [\n  message('device-xy-series-manifest', '//seriesAManifest', spectra[0].streamId, spectra[0].manifest),\n  message('device-xy-series-frame', '//seriesAFrame', spectra[0].streamId, spectra[0].frame),\n  message('device-xy-series-manifest', '//seriesBManifest', spectra[1].streamId, spectra[1].manifest),\n  message('device-xy-series-frame', '//seriesBFrame', spectra[1].streamId, spectra[1].frame),\n  message('device-xy-series-manifest', '//seriesCManifest', spectra[2].streamId, spectra[2].manifest),\n  message('device-xy-series-frame', '//seriesCFrame', spectra[2].streamId, spectra[2].frame),\n  message('device-xy-series-manifest', '//seriesDManifest', spectra[3].streamId, spectra[3].manifest),\n  message('device-xy-series-frame', '//seriesDFrame', spectra[3].streamId, spectra[3].frame),\n  message('device-xy-series-manifest', '//coordinatesManifest', coordinateStream, coordinateManifest),\n  message('device-xy-series-frame', '//coordinatesFrame', coordinateStream, coordinateFrame)\n]",
        "outputs": 10,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 180,
        "wires": [
            [
                "5ad8d2331b9b5b61"
            ],
            [
                "5ad8d2331b9b5b61"
            ],
