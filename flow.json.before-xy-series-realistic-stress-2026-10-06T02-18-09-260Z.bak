    {
        "id": "15f45309e23ec94e",
        "type": "ui-control-panel",
        "z": "cp_room01_binding_tab",
        "group": "",
        "page": "5661b2e62e1a41be",
        "ui": "",
        "name": "room01",
        "order": 0,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n  <div class=\"rc-demo\">\n    <header class=\"rc-header\">\n      <div class=\"rc-brand\"><v-icon icon=\"mdi-floor-plan\" size=\"28\"></v-icon>\n        <div><strong>SPACE / 01</strong><small>WORKPLACE CONTROL</small></div>\n      </div>\n      <div class=\"rc-online\"><span></span>ROOM 01 <time>{{ clock }}</time></div>\n    </header>\n    <div class=\"rc-title\">\n      <div>\n        <p>总部 · 三层 · 东区</p>\n        <h1>云端会议室</h1>\n      </div>\n      <div class=\"rc-occupancy\"><v-icon icon=\"mdi-account-group-outline\"></v-icon> 8 人空间 <span>可使用</span></div>\n    </div>\n    <nav class=\"rc-tabs\" aria-label=\"区域内导航\"><button v-for=\"page in pages\" :key=\"page.id\" :class=\"{active: activePage === page.id}\" :aria-current=\"activePage === page.id ? 'page' : undefined\" @click=\"activePage = page.id\"><v-icon :icon=\"page.icon\" size=\"20\"></v-icon>{{ page.label }}</button></nav>\n    <div class=\"rc-workspace\" :key=\"activePage\" :class=\"'rc-page-' + activePage\">\n      <section class=\"rc-space\">\n        <div class=\"rc-room\" :class=\"{ 'rc-screen-off': !display, 'rc-muted': muted }\"\n          :style=\"{ '--light': light / 100, '--curtain': curtains / 100 }\">\n          <img class=\"rc-photo\"\n            src=\"https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1600&q=85\"\n            alt=\"明亮的现代办公会议空间\" />\n          <div class=\"rc-shade\"></div>\n          <div class=\"rc-blinds\"></div>\n          <div class=\"rc-room-top\"><span><i></i> {{ pages.find(p => p.id === activePage).label }}</span><span>{{ sceneLabel }}</span></div>\n          <div class=\"rc-window-label\"><v-icon icon=\"mdi-blinds-horizontal\" size=\"16\"></v-icon> 窗帘 {{ curtains }}%</div>\n          <div class=\"rc-screen\"><v-icon :icon=\"display ? 'mdi-cast-connected' : 'mdi-monitor-off'\"\n              size=\"26\"></v-icon><strong>{{ display ? source : '屏幕待机' }}</strong><span>{{ display ? '准备共享内容' : '等待唤醒' }}</span>\n          </div>\n          <div class=\"rc-room-bottom\">\n            <div><small>当前场景</small>\n              <h2>{{ activePage === 'audio' ? (muted ? '输出已静音' : '音量 ' + volume + '%') : activePage === 'video' ? source : activePage === 'environment' ? '灯光 ' + light + '%' : sceneLabel }}</h2>\n            </div>\n            <div class=\"rc-wave\" aria-label=\"模拟音频电平\"><i v-for=\"n in 15\" :key=\"n\"\n                :style=\"{ '--i': n, animationDelay: (-n * .19) + 's' }\"></i></div>\n          </div>\n        </div>\n        <div class=\"rc-environment\" v-if=\"activePage === 'home' || activePage === 'environment'\">\n          <div><v-icon icon=\"mdi-thermometer\"></v-icon><span>室内温度<strong>{{ temperature.toFixed(1) }}<small>\n                  °C</small></strong></span></div>\n          <div><v-icon icon=\"mdi-water-percent\"></v-icon><span>相对湿度<strong>46<small> %</small></strong></span></div>\n          <div><v-icon icon=\"mdi-leaf\"></v-icon><span>空气质量<strong>优<small> · 428 ppm</small></strong></span></div>\n        </div>\n        <div class=\"rc-section-title\" v-if=\"activePage === 'home'\">\n          <h2>场景预设</h2><span>一键准备空间</span>\n        </div>\n        <div class=\"rc-scenes\" v-if=\"activePage === 'home'\"><button v-for=\"s in scenes\" :key=\"s.id\" :class=\"{ active: scene === s.id }\"\n            @click=\"scene = s.id\"><v-icon :icon=\"s.icon\"></v-icon><strong>{{ s.label }}</strong><small>{{ s.note\n              }}</small><v-icon v-if=\"scene === s.id\" class=\"rc-check\" icon=\"mdi-check-circle\" size=\"16\"></v-icon></button>\n        </div>\n      </section>\n      <aside class=\"rc-controls\">\n        <div class=\"rc-section-title\">\n          <h2>{{ pages.find(p => p.id === activePage).label === '首页' ? '空间状态' : pages.find(p => p.id === activePage).label + '控制' }}</h2><v-icon icon=\"mdi-tune-variant\" size=\"20\"></v-icon>\n        </div>\n        <div class=\"rc-devices\" v-if=\"activePage === 'home'\">\n          <div v-for=\"d in devices\" :key=\"d.name\"><v-icon :icon=\"d.icon\"></v-icon><span>{{ d.name }}<small>{{ d.detail }}</small></span><b :class=\"{ standby: !d.on }\">{{ d.on ? '就绪' : '待机' }}</b></div>\n        </div>\n        <div class=\"rc-control-block\" v-if=\"activePage === 'video'\">\n          <div class=\"rc-row\">\n            <div><v-icon icon=\"mdi-monitor\"></v-icon><strong>会议显示</strong></div><input id=\"room01-display\" class=\"rc-switch\" type=\"checkbox\" aria-label=\"会议显示电源\" v-model=\"display\" />\n          </div><label class=\"rc-label\">信号源</label><select id=\"room01-source\" v-model=\"source\" aria-label=\"信号源\">\n            <option>无线投屏</option>\n            <option>HDMI 1</option>\n            <option>HDMI 2</option>\n            <option>视频会议</option>\n          </select>\n        </div>\n        <div class=\"rc-control-block\" v-if=\"activePage === 'audio'\">\n          <div class=\"rc-row\">\n            <div><v-icon icon=\"mdi-volume-high\"></v-icon><strong>主音量</strong></div><b>{{ volume }}<small> %</small></b>\n          </div><input id=\"room01-volume\" v-model.number=\"volume\" type=\"range\" min=\"0\" max=\"100\" aria-label=\"主音量\" :style=\"rangeStyle(volume)\" />\n          <div class=\"rc-row rc-subrow\"><span>扬声器输出</span><button id=\"room01-mute\" type=\"button\" class=\"rc-icon-button\" :class=\"{ selected: muted }\"\n              :title=\"muted ? '取消静音' : '静音'\" :aria-label=\"muted ? '取消静音' : '静音'\" :aria-pressed=\"muted\"\n              ><v-icon :icon=\"muted ? 'mdi-volume-off' : 'mdi-volume-high'\" size=\"20\"></v-icon></button>\n          </div>\n        </div>\n        <div class=\"rc-control-block\" v-if=\"activePage === 'audio'\">\n          <div class=\"rc-row\">\n            <div><v-icon icon=\"mdi-volume-high\"></v-icon><strong>主音量 2</strong></div><b>{{ volume2 }}<small> %</small></b>\n          </div><input id=\"room01-volume2\" v-model.number=\"volume2\" type=\"range\" min=\"0\" max=\"100\" aria-label=\"主音量 2\" :style=\"rangeStyle(volume2)\" />\n          <div class=\"rc-row rc-subrow\"><span>扬声器输出 2</span><button id=\"room01-mute2\" type=\"button\" class=\"rc-icon-button\" :class=\"{ selected: muted2 }\"\n              :title=\"muted2 ? '取消静音' : '静音'\" :aria-label=\"muted2 ? '取消静音 2' : '静音 2'\" :aria-pressed=\"muted2\"\n              ><v-icon :icon=\"muted2 ? 'mdi-volume-off' : 'mdi-volume-high'\" size=\"20\"></v-icon></button>\n          </div>\n        </div>\n        <div class=\"rc-control-block\" v-if=\"activePage === 'environment'\">\n          <div class=\"rc-row\">\n            <div><v-icon icon=\"mdi-lightbulb-outline\"></v-icon><strong>环境灯光</strong></div><b>{{ light }}<small> %</small></b>\n          </div><input id=\"room01-light\" v-model.number=\"light\" type=\"range\" min=\"0\" max=\"100\" aria-label=\"灯光亮度\" :style=\"rangeStyle(light)\" />\n          <div class=\"rc-scale\"><span>柔和</span><span>明亮</span></div>\n        </div>\n        <div class=\"rc-control-block\" v-if=\"activePage === 'environment'\">\n          <div class=\"rc-row\">\n            <div><v-icon icon=\"mdi-blinds-horizontal\"></v-icon><strong>窗帘开度</strong></div><b>{{ curtains }}<small>\n                %</small></b>\n          </div><input id=\"room01-curtains\" v-model.number=\"curtains\" type=\"range\" min=\"0\" max=\"100\" aria-label=\"窗帘开度\" :style=\"rangeStyle(curtains)\" />\n          <div class=\"rc-scale\"><span>关闭</span><span>全开</span></div>\n        </div>\n        <div class=\"rc-control-block\" v-if=\"activePage === 'environment'\">\n          <div class=\"rc-row\">\n            <div><v-icon icon=\"mdi-air-conditioner\"></v-icon><strong>目标温度</strong></div>\n            <div class=\"rc-stepper\"><button class=\"rc-icon-button\" title=\"降低温度\" aria-label=\"降低温度\"\n                :disabled=\"temperature <= 16\" @click=\"temperature = Math.max(16, temperature - 0.5)\"><v-icon icon=\"mdi-minus\"\n                  size=\"18\"></v-icon></button><b>{{ temperature.toFixed(1) }}°</b><button class=\"rc-icon-button\" title=\"升高温度\"\n                aria-label=\"升高温度\" :disabled=\"temperature >= 30\" @click=\"temperature = Math.min(30, temperature + 0.5)\"><v-icon icon=\"mdi-plus\"\n                  size=\"18\"></v-icon></button></div>\n          </div>\n        </div>\n        <div class=\"rc-session\" v-if=\"activePage === 'home'\">\n          <div><span>会议状态</span><strong>{{ meeting ? '会议进行中' : '准备就绪' }}</strong></div><button\n            id=\"room01-meeting\" type=\"button\" :aria-pressed=\"meeting\"><v-icon :icon=\"meeting ? 'mdi-stop' : 'mdi-play'\" size=\"18\"></v-icon>{{ meeting ? '结束会议' :\n            '开始会议' }}</button>\n        </div>\n      </aside>\n      <aside class=\"rc-volume-rail\" :class=\"{ 'rc-volume-rail--inactive': activePage !== 'audio' }\"\n        :aria-hidden=\"activePage !== 'audio'\" aria-label=\"音量指示\">\n        <div class=\"rc-volume-meter\">\n          <span class=\"rc-volume-meter-label\">L1</span>\n          <meter id=\"room01-volume-meter-1\" :value=\"meter1\" min=\"0\" max=\"100\" aria-label=\"实时信号电平 L1\"></meter>\n          <strong>{{ meter1 }}<small>%</small></strong>\n        </div>\n        <div class=\"rc-volume-meter\">\n          <span class=\"rc-volume-meter-label\">L2</span>\n          <meter id=\"room01-volume-meter-2\" :value=\"meter2\" min=\"0\" max=\"100\" aria-label=\"实时信号电平 L2\"></meter>\n          <strong>{{ meter2 }}<small>%</small></strong>\n        </div>\n      </aside>\n    </div>\n    <footer class=\"rc-footer\"><span><v-icon icon=\"mdi-shield-check-outline\" size=\"16\"></v-icon> ROOM 01</span><button\n        type=\"button\" @click=\"reset\"><v-icon icon=\"mdi-refresh\" size=\"16\"></v-icon>重置场景</button></footer>\n    <transition name=\"rc-toast\">\n      <div v-if=\"notice\" class=\"rc-toast-message\" role=\"status\"><v-icon icon=\"mdi-check-circle\" size=\"19\"></v-icon>{{ notice }}\n      </div>\n    </transition>\n  </div>\n</template>\n<script>\nexport default {\n  data () {\n    return {\n      clock: '', scene: 'custom', display: false, source: '无线投屏',\n      volume: 0, muted: false, volume2: 0, muted2: false,\n      meter1: 0, meter2: 0,\n      light: 0, curtains: 0, temperature: 23, meeting: false,\n      notice: '', clockTimer: null, noticeTimer: null, activePage: 'home',\n      pages: [\n        { id: 'home', label: '首页', icon: 'mdi-home-outline' },\n        { id: 'audio', label: '音频', icon: 'mdi-volume-high' },\n        { id: 'video', label: '视频', icon: 'mdi-monitor' },\n        { id: 'environment', label: '环境', icon: 'mdi-lightbulb-outline' }\n      ],\n      scenes: [\n        { id: 'meeting', label: '日常会议', note: '明亮 · 协作', icon: 'mdi-account-group-outline' },\n        { id: 'present', label: '演示汇报', note: '聚焦 · 分享', icon: 'mdi-presentation' },\n        { id: 'video', label: '远程会议', note: '清晰 · 连接', icon: 'mdi-video-outline' },\n        { id: 'relax', label: '休息模式', note: '舒缓 · 放松', icon: 'mdi-coffee-outline' }\n      ]\n    }\n  },\n  computed: {\n    sceneLabel () {\n      return this.scenes.find(item => item.id === this.scene)?.label || '自定义场景'\n    },\n    devices () {\n      return [\n        { name: '会议显示屏', detail: this.source, icon: 'mdi-monitor', on: this.display },\n        { name: '音频处理器', detail: this.muted ? '输出已静音' : '立体声 · 自动混音', icon: 'mdi-waveform', on: !this.muted },\n        { name: '会议摄像机', detail: '自动取景', icon: 'mdi-video-outline', on: this.meeting },\n        { name: '环境控制', detail: '灯光 / 窗帘 / 空调', icon: 'mdi-home-automation', on: this.light > 0 }\n      ]\n    }\n  },\n  methods: {\n    rangeStyle (value) {\n      return { background: 'linear-gradient(to right, #147d70 ' + value + '%, #dce3df ' + value + '%)' }\n    },\n    reset () {\n      this.scene = 'custom'\n      this.notice = '已重置页面'\n      clearTimeout(this.noticeTimer)\n      this.noticeTimer = setTimeout(() => { this.notice = '' }, 2400)\n    },\n    tick () {\n      this.clock = new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' })\n    }\n  },\n  mounted () {\n    this.tick()\n    this.clockTimer = setInterval(() => this.tick(), 1000)\n  },\n  unmounted () {\n    clearInterval(this.clockTimer)\n    clearTimeout(this.noticeTimer)\n  }\n}\n</script>\n<style>\n.rc-demo {\n  --ink: #20312e;\n  --green: #147d70;\n  --line: #dfe6e2;\n  color: var(--ink);\n  background: #d2ffd2;\n  font-family: Inter, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  padding: 24px 32px;\n  max-width: 1500px;\n  margin: auto;\n  letter-spacing: 0;\n  font-size: 14px\n}\n\n.rc-demo * {\n  box-sizing: border-box;\n  letter-spacing: 0\n}\n\n.rc-demo button,\n.rc-demo input,\n.rc-demo select {\n  font: inherit\n}\n\n.rc-demo button {\n  cursor: pointer\n}\n\n.rc-demo button:focus-visible,\n.rc-demo input:focus-visible,\n.rc-demo select:focus-visible {\n  outline: 3px solid #36a99a;\n  outline-offset: 4px\n}\n\n.rc-demo button:disabled {\n  opacity: .4;\n  cursor: default\n}\n\n.rc-header,\n.rc-title,\n.rc-row,\n.rc-section-title,\n.rc-footer {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 12px\n}\n\n.rc-header {\n  padding-bottom: 20px;\n  border-bottom: 1px solid var(--line)\n}\n\n.rc-brand {\n  display: flex;\n  gap: 12px;\n  align-items: center\n}\n\n.rc-brand strong {\n  display: block;\n  font-size: 17px\n}\n\n.rc-brand small {\n  display: block;\n  font-size: 9px;\n  color: #72807a;\n  margin-top: 3px\n}\n\n.rc-online {\n  display: flex;\n  gap: 9px;\n  align-items: center;\n  color: #66766e;\n  font-size: 12px\n}\n\n.rc-online>span,\n.rc-room-top i {\n  width: 6px;\n  height: 6px;\n  background: #4fc8a0;\n  border-radius: 50%;\n  display: inline-block\n}\n\n.rc-online time {\n  font-size: 18px;\n  font-variant-numeric: tabular-nums;\n  margin-left: 20px;\n  color: var(--ink)\n}\n\n.rc-title {\n  padding: 24px 0\n}\n\n.rc-title p {\n  color: #74817a;\n  font-size: 12px;\n  margin: 0 0 6px\n}\n\n.rc-title h1 {\n  font-size: 28px;\n  line-height: 1.3;\n  margin: 0;\n  font-weight: 650\n}\n\n.rc-occupancy {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 12px;\n  color: #738079\n}\n\n.rc-occupancy span {\n  color: #147d70;\n  margin-left: 10px\n}\n\n.rc-workspace {\n  display: grid;\n  grid-template-columns: minmax(0, 1.8fr) minmax(300px, 1fr);\n  gap: 30px\n}\n\n.rc-space {\n  min-width: 0\n}\n\n.rc-room {\n  position: relative;\n  aspect-ratio: 16/9;\n  min-height: 260px;\n  overflow: hidden;\n  background: #263c3a;\n  color: white;\n  border-radius: 6px;\n  isolation: isolate\n}\n\n.rc-photo {\n  width: 100%;\n  height: 100%;\n  position: absolute;\n  inset: 0;\n  object-fit: cover;\n  filter: brightness(calc(.35 + var(--light)*.65));\n  transition: filter 1.3s, transform 6s;\n  transform: scale(1.025)\n}\n\n.rc-room:hover .rc-photo {\n  transform: scale(1.06)\n}\n\n.rc-shade {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(180deg, rgba(8, 22, 19, .3), transparent 40%, rgba(8, 22, 19, .85))\n}\n\n.rc-blinds {\n  position: absolute;\n  left: 0;\n  top: 0;\n  width: 42%;\n  height: 65%;\n  background: repeating-linear-gradient(0deg, rgba(26, 45, 39, .68) 0 8px, rgba(153, 168, 148, .42) 8px 10px);\n  transform: scaleY(calc(1 - var(--curtain)));\n  transform-origin: top;\n  transition: transform 1.5s ease-in-out\n}\n\n.rc-room-top {\n  position: absolute;\n  top: 20px;\n  left: 22px;\n  right: 22px;\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  font-size: 10px\n}\n\n.rc-room-top i {\n  margin-right: 6px\n}\n\n.rc-window-label {\n  position: absolute;\n  top: 28%;\n  left: 22px;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  background: #142a2770;\n  padding: 6px 9px;\n  border-radius: 4px;\n  font-size: 11px\n}\n\n.rc-screen {\n  position: absolute;\n  right: 12%;\n  top: 27%;\n  width: 30%;\n  height: 36%;\n  background: #132925e8;\n  border: 1px solid #92b5a580;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  gap: 6px;\n  box-shadow: 0 12px 28px #0003;\n  transition: background 1s, color 1s;\n  color: #e5fff3\n}\n\n.rc-screen strong {\n  font-size: 13px\n}\n\n.rc-screen span {\n  font-size: 9px;\n  color: #b5cfc6\n}\n\n.rc-screen-off .rc-screen {\n  background: #242928;\n  color: #7b8783\n}\n\n.rc-room-bottom {\n  position: absolute;\n  bottom: 24px;\n  left: 24px;\n  right: 24px;\n  display: flex;\n  justify-content: space-between;\n  align-items: end\n}\n\n.rc-room-bottom small {\n  font-size: 11px;\n  color: #c4d2cb\n}\n\n.rc-room-bottom h2 {\n  margin: 5px 0 0;\n  font-size: 23px\n}\n\n.rc-wave {\n  display: flex;\n  align-items: center;\n  height: 30px;\n  gap: 3px\n}\n\n.rc-wave i {\n  width: 3px;\n  height: 24px;\n  background: #8ae5c1;\n  transform-origin: center;\n  animation: rc-level 1.2s ease-in-out infinite alternate\n}\n\n.rc-muted .rc-wave i {\n  animation-play-state: paused;\n  transform: scaleY(.12);\n  background: #a8b5ad\n}\n\n.rc-environment {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  padding: 20px 0;\n  border-bottom: 1px solid var(--line);\n  gap: 10px\n}\n\n.rc-environment>div {\n  display: flex;\n  gap: 10px;\n  align-items: center\n}\n\n.rc-environment .v-icon {\n  color: #70847a\n}\n\n.rc-environment span {\n  font-size: 11px;\n  color: #718179\n}\n\n.rc-environment strong {\n  display: block;\n  margin-top: 4px;\n  font-size: 23px;\n  color: var(--ink);\n  font-weight: 550\n}\n\n.rc-environment small {\n  font-size: 11px;\n  font-weight: 400;\n  color: #6f7d75\n}\n\n.rc-section-title {\n  margin: 22px 0 15px\n}\n\n.rc-section-title h2 {\n  font-size: 15px;\n  margin: 0;\n  font-weight: 650\n}\n\n.rc-section-title>span {\n  font-size: 11px;\n  color: #87918b\n}\n\n.rc-scenes {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 10px\n}\n\n.rc-scenes button {\n  text-align: left;\n  position: relative;\n  background: #fff;\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  padding: 15px 12px;\n  min-height: 106px;\n  transition: background .25s, border-color .25s, transform .25s\n}\n\n.rc-scenes button:hover {\n  transform: translateY(-2px);\n  border-color: #8aa99b\n}\n\n.rc-scenes button.active {\n  background: #e6f1e9;\n  border-color: #83ad95\n}\n\n.rc-scenes button>.v-icon {\n  color: #527263;\n  margin-bottom: 10px\n}\n\n.rc-scenes strong,\n.rc-scenes small {\n  display: block\n}\n\n.rc-scenes strong {\n  font-size: 13px\n}\n\n.rc-scenes small {\n  font-size: 10px;\n  color: #7b897f;\n  margin-top: 5px\n}\n\n.rc-scenes .rc-check {\n  position: absolute;\n  right: 8px;\n  top: 10px;\n  color: #147d70\n}\n\n.rc-devices {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 0 20px\n}\n\n.rc-devices>div {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  min-width: 0;\n  padding: 13px 0;\n  border-bottom: 1px solid var(--line)\n}\n\n.rc-devices>div>.v-icon {\n  color: #708278;\n  font-size: 21px\n}\n\n.rc-devices span {\n  font-size: 12px;\n  flex: 1\n}\n\n.rc-devices small {\n  display: block;\n  font-size: 10px;\n  color: #859188;\n  margin-top: 4px\n}\n\n.rc-devices b {\n  font-size: 10px;\n  font-weight: 500;\n  color: #147d70\n}\n\n.rc-devices b.standby {\n  color: #9b8753\n}\n\n.rc-controls {\n  border-left: 1px solid var(--line);\n  padding-left: 28px\n}\n\n.rc-controls>.rc-section-title {\n  margin-top: 0\n}\n\n.rc-control-block {\n  padding: 15px 0;\n  border-bottom: 1px solid var(--line)\n}\n\n.rc-row>div:first-child {\n  display: flex;\n  align-items: center;\n  gap: 10px\n}\n\n.rc-row .v-icon {\n  color: #71847a\n}\n\n.rc-row strong {\n  font-size: 13px;\n  font-weight: 550\n}\n\n.rc-row>b {\n  font-size: 19px;\n  font-weight: 550;\n  font-variant-numeric: tabular-nums\n}\n\n.rc-row b small {\n  font-size: 11px;\n  color: #8a968f\n}\n\n.rc-switch {\n  flex: 0 0 auto;\n  appearance: none;\n  width: 40px;\n  height: 22px;\n  border-radius: 11px;\n  background: #aab8b0;\n  cursor: pointer;\n  position: relative;\n}\n.rc-switch::after {\n  content: '';\n  position: absolute;\n  top: 3px;\n  left: 3px;\n  width: 16px;\n  height: 16px;\n  border-radius: 50%;\n  background: #fff;\n  transition: transform .2s;\n}\n.rc-switch:checked { background: #147d70; }\n.rc-switch:checked::after { transform: translateX(18px); }\n\n.rc-label {\n  display: block;\n  font-size: 11px;\n  color: #839088;\n  margin: 6px 0 8px\n}\n\n.rc-demo select {\n  width: 100%;\n  padding: 10px 12px;\n  border: 1px solid var(--line);\n  border-radius: 4px;\n  appearance: auto;\n  background: #fff;\n  color: var(--ink);\n  font-size: 12px\n}\n\n.rc-demo select:disabled {\n  opacity: .45\n}\n\n.rc-demo input[type=range] {\n  appearance: none;\n  width: 100%;\n  height: 4px;\n  border-radius: 2px;\n  display: block;\n  margin: 22px 0 13px;\n  cursor: pointer\n}\n\n.rc-demo input[type=range]::-webkit-slider-thumb {\n  appearance: none;\n  width: 16px;\n  height: 16px;\n  background: white;\n  border: 3px solid #147d70;\n  border-radius: 50%;\n  box-shadow: 0 1px 4px #0002\n}\n\n.rc-demo input[type=range]::-moz-range-thumb {\n  width: 12px;\n  height: 12px;\n  background: white;\n  border: 3px solid #147d70;\n  border-radius: 50%\n}\n\n.rc-scale,\n.rc-subrow {\n  display: flex;\n  justify-content: space-between;\n  color: #839088;\n  font-size: 10px\n}\n\n.rc-icon-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 30px;\n  height: 30px;\n  border: 1px solid var(--line);\n  background: white;\n  border-radius: 4px\n}\n\n.rc-icon-button.selected {\n  background: #e6f1e9;\n  border-color: #147d70\n}\n\n.rc-stepper {\n  display: flex;\n  align-items: center;\n  gap: 9px\n}\n\n.rc-stepper b {\n  font-size: 17px;\n  min-width: 44px;\n  text-align: center\n}\n\n.rc-session {\n  margin-top: 22px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 10px\n}\n\n.rc-session span {\n  display: block;\n  font-size: 10px;\n  color: #859189\n}\n\n.rc-session strong {\n  display: block;\n  font-size: 13px;\n  margin-top: 4px\n}\n\n.rc-session button {\n  background: #147d70;\n  color: white;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  border-radius: 4px;\n  padding: 11px 14px;\n  font-size: 12px\n}\n\n.rc-footer {\n  margin-top: 28px;\n  padding-top: 17px;\n  border-top: 1px solid var(--line);\n  color: #8b968f;\n  font-size: 10px\n}\n\n.rc-footer>span,\n.rc-footer button {\n  display: flex;\n  align-items: center;\n  gap: 6px\n}\n\n.rc-footer button {\n  color: #59766a\n}\n\n.rc-toast-message {\n  position: fixed;\n  z-index: 999;\n  bottom: 30px;\n  left: 50%;\n  transform: translateX(-50%);\n  max-width: calc(100vw - 32px);\n  padding: 13px 22px;\n  background: #1e3c32;\n  color: white;\n  box-shadow: 0 8px 28px #0003;\n  border-radius: 6px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-size: 13px\n}\n\n.rc-toast-enter-active,\n.rc-toast-leave-active {\n  transition: opacity .2s, margin .2s\n}\n\n.rc-toast-enter-from,\n.rc-toast-leave-to {\n  opacity: 0;\n  margin-bottom: -8px\n}\n\n@keyframes rc-level {\n  0% {\n    transform: scaleY(.2)\n  }\n\n  100% {\n    transform: scaleY(.95)\n  }\n}\n\n@media(max-width:1000px) {\n  .rc-demo {\n    padding: 20px\n  }\n\n  .rc-workspace {\n    grid-template-columns: minmax(0, 1.4fr) minmax(260px, 1fr);\n    gap: 20px\n  }\n\n  .rc-controls {\n    padding-left: 20px\n  }\n\n  .rc-scenes {\n    grid-template-columns: 1fr 1fr\n  }\n\n  .rc-environment>div {\n    gap: 5px\n  }\n\n  .rc-environment strong {\n    font-size: 19px\n  }\n}\n\n@media(max-width:720px) {\n  .rc-demo {\n    padding: 16px\n  }\n\n  .rc-workspace {\n    grid-template-columns: 1fr\n  }\n\n  .rc-controls {\n    padding: 20px 0 0;\n    border-left: 0;\n    border-top: 1px solid var(--line)\n  }\n\n  .rc-title h1 {\n    font-size: 24px\n  }\n\n  .rc-occupancy {\n    display: none\n  }\n\n  .rc-room {\n    min-height: 240px\n  }\n\n  .rc-online time {\n    margin-left: 3px\n  }\n\n  .rc-brand strong {\n    font-size