x-width:760px){.r2-stage{flex:none}.r2-console{grid-template-rows:auto auto auto auto;gap:16px}.r2-climate{min-height:180px}.r2-video{grid-template-rows:auto 180px 46px;height:auto;overflow:visible}.r2-video .r2-screen{height:auto}.r2-select,.r2-select select{height:46px;min-height:46px;max-height:46px}.r2-dial{width:170px;height:170px}}\n@media(prefers-reduced-motion:reduce){.r2 *{animation:none!important;transition:none!important}}\n</style>\n",
        "visualBindings": "{\"control.927f100e2bb4\":{\"locator\":\"tag:f3d856ff927f100e2bb4\",\"adapter\":\"range\",\"type\":\"level\",\"label\":\"主音量\",\"mode\":\"both\",\"model\":\"volume\",\"uiRange\":{\"min\":0,\"max\":100,\"step\":\"1\"},\"device\":\"Precis Driver\",\"writePath\":\"//processors/1/channels/1/level1\",\"readPath\":\"//processors/1/channels/1/level1\",\"writeMeta\":{\"kind\":\"param\",\"type\":\"integer\",\"access\":\"rw\",\"onebased\":false,\"min\":0,\"max\":100,\"controlType\":\"slider\",\"controlSchemaVersion\":1},\"readMeta\":{\"kind\":\"param\",\"type\":\"integer\",\"access\":\"rw\",\"onebased\":false,\"min\":0,\"max\":100,\"controlType\":\"slider\",\"controlSchemaVersion\":1}},\"control.80ef25e1985d\":{\"locator\":\"tag:cac2a3ef80ef25e1985d\",\"adapter\":\"switch\",\"type\":\"mute\",\"label\":\"muted\",\"mode\":\"both\",\"model\":\"muted\",\"device\":\"Precis Driver\",\"writePath\":\"//processors/1/channels/1/mute1\",\"readPath\":\"//processors/1/channels/1/mute1\",\"writeMeta\":{\"kind\":\"param\",\"type\":\"boolean\",\"access\":\"rw\",\"onebased\":false,\"min\":0,\"max\":1,\"controlType\":\"toggle\",\"controlSchemaVersion\":1},\"readMeta\":{\"kind\":\"param\",\"type\":\"boolean\",\"access\":\"rw\",\"onebased\":false,\"min\":0,\"max\":1,\"controlType\":\"toggle\",\"controlSchemaVersion\":1}},\"control.79ff4a0c271f\":{\"locator\":\"tag:30ba178679ff4a0c271f\",\"adapter\":\"switch\",\"type\":\"mute\",\"label\":\"空间电源\",\"mode\":\"both\",\"model\":\"power\",\"device\":\"Precis Driver\",\"writePath\":\"//processors/1/channels/1/mute2\",\"readPath\":\"//processors/1/channels/1/mute2\",\"writeMeta\":{\"kind\":\"param\",\"type\":\"boolean\",\"access\":\"rw\",\"onebased\":false,\"min\":0,\"max\":1,\"controlType\":\"toggle\",\"controlSchemaVersion\":1},\"readMeta\":{\"kind\":\"param\",\"type\":\"boolean\",\"access\":\"rw\",\"onebased\":false,\"min\":0,\"max\":1,\"controlType\":\"toggle\",\"controlSchemaVersion\":1}},\"control.c10d2a5b2a14\":{\"locator\":\"tag:525fa9d9c10d2a5b2a14\",\"adapter\":\"range\",\"type\":\"level\",\"label\":\"灯光亮度\",\"mode\":\"both\",\"model\":\"light\",\"uiRange\":{\"min\":0,\"max\":100,\"step\":\"1\"},\"device\":\"Precis Driver\",\"writePath\":\"//processors/1/channels/1/level2\",\"readPath\":\"//processors/1/channels/1/level2\",\"writeMeta\":{\"kind\":\"param\",\"type\":\"integer\",\"access\":\"rw\",\"onebased\":false,\"min\":0,\"max\":100,\"controlType\":\"slider\",\"controlSchemaVersion\":1},\"readMeta\":{\"kind\":\"param\",\"type\":\"integer\",\"access\":\"rw\",\"onebased\":false,\"min\":0,\"max\":100,\"controlType\":\"slider\",\"controlSchemaVersion\":1}}}",
