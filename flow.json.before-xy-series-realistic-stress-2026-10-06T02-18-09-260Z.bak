    {
        "id": "a1467006d5cde078",
        "type": "ui-control-panel",
        "z": "cp_room01_binding_tab",
        "group": "",
        "page": "r2_ui_page",
        "ui": "",
        "name": "room02",
        "order": 0,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n  <div class=\"r2\" :style=\"{'--level': volume / 100}\" :class=\"{quiet: muted}\">\n    <header class=\"r2-head\"><div class=\"r2-logo\"><v-icon icon=\"mdi-waveform\"></v-icon><strong>ATELIER<span>ROOM / 02</span></strong></div><div class=\"r2-status\"><i></i> DEVICE ONLINE <time>{{ clock }}</time></div></header>\n    <div class=\"r2-title\"><div><small>THE IMMERSIVE SUITE</small><h1>空间，由你定义<span>02</span></h1></div><button class=\"r2-power\" :class=\"{on: power}\" :aria-pressed=\"power\" title=\"空间电源\"><v-icon icon=\"mdi-power\"></v-icon></button></div>\n    <nav class=\"r2-tabs\"><button v-for=\"t in tabs\" :key=\"t.id\" :class=\"{selected: tab === t.id}\" @click=\"tab=t.id\"><v-icon :icon=\"t.icon\" size=\"19\"></v-icon>{{ t.label }}<span v-if=\"tab===t.id\" class=\"r2-tabdot\"></span></button><span class=\"r2-tabnote\">PRIVATE EXPERIENCE / 02</span></nav>\n    <div class=\"r2-stage\">\n    <main class=\"r2-main\" :key=\"tab\">\n      <section class=\"r2-visual\" :class=\"{off: !power}\">\n        <img src=\"https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=1600&q=85\" alt=\"现代休闲会议空间\" :style=\"{filter: 'brightness(' + (0.45 + light / 180) + ')'}\"/>\n        <div class=\"r2-photo-shade\"></div>\n        <div class=\"r2-visual-top\"><span><i></i> {{ sceneLabel }}</span><span>FLOOR 03 / EAST</span></div>\n        <div class=\"r2-hotspot h1\"><span></span><b>AMBIENT LIGHT <strong>{{light}}%</strong></b></div><div class=\"r2-hotspot h2\"><span></span><b>{{source}} <strong>{{power ? 'READY' : 'OFF'}}</strong></b></div>\n        <div class=\"r2-visual-bottom\"><small>{{tab === 'audio' ? 'SOUND EXPERIENCE' : tab === 'environment' ? 'PERFECT ATMOSPHERE' : 'YOUR SPACE. YOUR RHYTHM.'}}</small><h2>{{ tab === 'audio' ? '让声音填满空间' : tab === 'environment' ? '恰到好处的舒适' : tab === 'video' ? '精彩，即刻呈现' : '一切，恰如所愿。' }}</h2><div class=\"r2-metrics\"><span><v-icon icon=\"mdi-thermometer\" size=\"18\"></v-icon>{{temperature.toFixed(1)}}°<small>温度</small></span><span><v-icon icon=\"mdi-water-percent\" size=\"18\"></v-icon>46%<small>湿度 · 模拟</small></span><span><v-icon icon=\"mdi-leaf\" size=\"18\"></v-icon>优<small>空气 · 模拟</small></span></div></div>\n        <div class=\"r2-scan\"></div>\n      </section>\n      <section class=\"r2-console\">\n        <div class=\"r2-section-label\"><span>{{tabTitle}}</span><small>LIVE PREVIEW</small></div>\n        <template v-if=\"tab==='home' || tab==='audio'\">\n          <div class=\"r2-audio\"><div class=\"r2-line\"><div><small>MASTER OUTPUT</small><h2>空间声场</h2></div><button class=\"r2-icon\" :aria-pressed=\"muted\" :title=\"muted?'取消静音':'静音'\"><v-icon :icon=\"muted?'mdi-volume-off':'mdi-volume-high'\"></v-icon></button></div><div class=\"r2-levels\" :class=\"{paused: muted || !power}\"><i v-for=\"n in 40\" :key=\"n\" :style=\"{height:(15+((n*17)%70))+'%',animationDelay:(-n*.137)+'s',animationDuration:(.5+(n%7)*.13)+'s'}\"></i></div><div class=\"r2-volume\"><strong>{{ muted ? '—' : volume }}<small>%</small></strong><span>{{muted?'已静音':'主音量'}}<small>STEREO / 设备反馈</small></span></div><input aria-label=\"主音量\" type=\"range\" min=\"0\" max=\"100\" v-model.number=\"volume\" :style=\"track(volume)\"/></div>\n        </template>\n        <template v-if=\"tab==='video'\"><div class=\"r2-video\"><div class=\"r2-line\"><h2>信号矩阵</h2><v-icon icon=\"mdi-cast-connected\"></v-icon></div><div class=\"r2-screen\"><v-icon :icon=\"power?'mdi-monitor':'mdi-monitor-off'\" size=\"46\"></v-icon><strong>{{power?source:'待机'}}</strong><span>{{power?'3840 × 2160 / DEVICE':'NO SIGNAL'}}</span><i v-if=\"power\" class=\"r2-signal\"></i></div><label class=\"r2-select\">输入源<select v-model=\"source\"><option>无线投屏</option><option>HDMI 1</option><option>HDMI 2</option><option>视频会议</option></select></label></div></template>\n        <template v-if=\"tab==='environment'\"><div class=\"r2-climate\"><div class=\"r2-dial\" :style=\"{'--angle': ((temperature-16)/14*270)+'deg'}\"><div><small>SET POINT</small><strong>{{temperature.toFixed(1)}}<sup>°</sup></strong><span>设备反馈</span></div></div><div class=\"r2-temp\"><button class=\"r2-icon\" title=\"降低温度\" @click=\"temperature=Math.max(16,temperature-.5)\"><v-icon icon=\"mdi-minus\"></v-icon></button><span>16° — 30°</span><button class=\"r2-icon\" title=\"提高温度\" @click=\"temperature=Math.min(30,temperature+.5)\"><v-icon icon=\"mdi-plus\"></v-icon></button></div></div></template>\n        <div class=\"r2-lights\"><div class=\"r2-line\"><span><v-icon icon=\"mdi-lightbulb-outline\" size=\"21\"></v-icon>氛围灯光</span><strong>{{light}}<small>%</small></strong></div><input aria-label=\"灯光亮度\" type=\"range\" min=\"0\" max=\"100\" v-model.number=\"light\" :style=\"track(light)\"/></div>\n        <div class=\"r2-curtains\"><div class=\"r2-line\"><span><v-icon icon=\"mdi-blinds-horizontal\" size=\"21\"></v-icon>遮阳帘</span><strong>{{curtains}}<small>%</small></strong></div><input aria-label=\"窗帘开度\" type=\"range\" min=\"0\" max=\"100\" v-model.number=\"curtains\" :style=\"track(curtains)\"/></div>\n      </section>\n    </main>\n    </div>\n    <section class=\"r2-scenes\"><div class=\"r2-scene-title\"><small>ONE TOUCH</small><h2>切换氛围</h2></div><button v-for=\"s in scenes\" :key=\"s.id\" :class=\"{active: scene===s.id}\" @click=\"scene=s.id\"><v-icon :icon=\"s.icon\"></v-icon><span>{{s.name}}<small>{{s.en}}</small></span><v-icon :icon=\"scene===s.id?'mdi-check-circle':'mdi-arrow-top-right'\" size=\"18\"></v-icon></button></section>\n    <footer class=\"r2-footer\"><span><i></i> ROOM 02 <b>VISUAL BINDINGS</b></span><button class=\"r2-icon\" title=\"清除本地页面状态\" @click=\"volume=0;light=0;curtains=0;temperature=23;power=false;muted=false;source='';scene='custom'\"><v-icon icon=\"mdi-refresh\" size=\"18\"></v-icon></button></footer>\n  </div>\n</template>\n<script>\nexport default {\n  data(){return {tab:'home',volume:0,light:0,curtains:0,temperature:23,power:false,muted:false,source:'无线投屏',scene:'custom',clock:'',timer:null,tabs:[{id:'home',label:'总览',icon:'mdi-view-dashboard-outline'},{id:'audio',label:'音频',icon:'mdi-waveform'},{id:'video',label:'视频',icon:'mdi-monitor'},{id:'environment',label:'环境',icon:'mdi-tune-variant'}],scenes:[{id:'focus',name:'专注',en:'FOCUS',icon:'mdi-target',light:85,volume:25},{id:'cinema',name:'影院',en:'CINEMA',icon:'mdi-movie-open-outline',light:20,volume:65},{id:'social',name:'会客',en:'SOCIAL',icon:'mdi-account-group-outline',light:70,volume:40},{id:'relax',name:'放松',en:'UNWIND',icon:'mdi-weather-night',light:35,volume:32}]}},\n  computed:{sceneLabel(){return this.scenes.find(s=>s.id===this.scene)?.en || 'CUSTOM'},tabTitle(){return {home:'空间控制',audio:'音频控制',video:'视频控制',environment:'环境控制'}[this.tab]}},\n  methods:{track(v){return {background:`linear-gradient(90deg,#bafc72 ${v}%,#363936 ${v}%)`}},tick(){this.clock=new Date().toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'})}},\n  mounted(){this.tick();this.timer=setInterval(this.tick,1000)},unmounted(){clearInterval(this.timer)}\n}\n</script>\n<style>\n.r2{--accent:#bafc72;background:#151715;color:#f5f7ef;font-family:Inter,'PingFang SC',sans-serif;padding:22px 36px;min-height:100dvh;display:flex;flex-direction:column;gap:18px;letter-spacing:0;box-sizing:border-box}.r2 *{box-sizing:border-box;letter-spacing:0}.r2 button,.r2 input,.r2 select{font:inherit}.r2 button{cursor:pointer;color:inherit;border:0}.r2 button:focus-visible,.r2 input:focus-visible,.r2 select:focus-visible{outline:2px solid var(--accent);outline-offset:4px}.r2-head,.r2-title,.r2-line,.r2-visual-top,.r2-footer{display:flex;align-items:center;justify-content:space-between;gap:16px}.r2-head{padding-bottom:14px;border-bottom:1px solid #343732}.r2-logo{display:flex;align-items:center;gap:12px}.r2-logo>.v-icon{color:var(--accent);font-size:32px}.r2-logo strong{font-size:18px}.r2-logo strong span{display:block;font-size:9px;color:#939b8f;margin-top:3px}.r2-status{font-size:10px;color:#b0b7aa;display:flex;gap:10px;align-items:center}.r2-status i,.r2-footer i{display:inline-block;width:6px;height:6px;background:var(--accent);border-radius:50%}.r2-status time{font-size:20px;margin-left:22px;font-variant-numeric:tabular-nums}.r2-title small,.r2-scene-title small{font-size:9px;color:#a7af9f}.r2-title h1{font-size:30px;margin:4px 0 0;font-weight:500}.r2-title h1 span{color:#788170;font-size:15px;margin-left:18px}.r2-power{width:46px;height:46px;border-radius:50%;background:#383b35}.r2-power.on{background:var(--accent);color:#18230e;box-shadow:0 0 22px #bafc7222}.r2-tabs{display:flex;align-items:center;gap:8px;border-bottom:1px solid #343732;padding-bottom:12px}.r2-tabs button{background:transparent;display:flex;align-items:center;gap:8px;padding:10px 18px;border-radius:4px;color:#a0a798;font-size:13px;position:relative;min-height:42px}.r2-tabs button.selected{background:#bafc72;color:#17220c}.r2-tabs button:hover{box-shadow:inset 0 0 0 1px #bafc72}.r2-tabnote{margin-left:auto;font-size:9px;color:#788170}.r2-main{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(290px,1fr);gap:28px;flex:1;min-height:0;animation:r2-enter .4s ease both}.r2-visual{position:relative;overflow:hidden;min-height:320px;isolation:isolate}.r2-visual>img{position:absolute;width:100%;height:100%;object-fit:cover;transition:filter 1s,transform 9s;transform:scale(1.03)}.r2-visual:hover>img{transform:scale(1.1)}.r2-visual.off>img{filter:brightness(.2) grayscale(1)!important}.r2-photo-shade{position:absolute;inset:0;background:linear-gradient(0deg,#0b140eef,transparent 85%)}.r2-visual-top{position:absolute;top:20px;left:22px;right:22px;font-size:9px;color:#e4e8dc}.r2-visual-top span:first-child{padding:7px 10px;background:#172019c9;border:1px solid #92aa7c66}.r2-visual-top i{display:inline-block;width:5px;height:5px;background:var(--accent);margin-right:5px}.r2-visual-bottom{position:absolute;bottom:24px;left:24px;right:24px}.r2-visual-bottom>small{color:#c5d4b9;font-size:9px}.r2-visual h2{font-size:26px;font-weight:500;margin:8px 0 20px}.r2-metrics{display:flex;gap:28px;padding-top:17px;border-top:1px solid #bbcdb433}.r2-metrics>span{font-size:18px;display:flex;align-items:center;gap:6px;flex-wrap:wrap}.r2-metrics small{width:100%;font-size:9px;color:#aebda5}.r2-hotspot{position:absolute;display:flex;align-items:center;gap:12px}.r2-hotspot>span{width:14px;height:14px;border:2px solid #dcffc6;border-radius:50%;box-shadow:0 0 0 8px #c0ff7622;animation:r2-pulse 3s infinite}.r2-hotspot b{background:#1b241ddd;padding:8px;font-size:8px;font-weight:400;display:flex;flex-direction:column;gap:4px;color:#b5c6aa}.r2-hotspot strong{color:white;font-size:12px}.r2-hotspot.h1{top:27%;left:13%}.r2-hotspot.h2{top:40%;right:9%}.r2-scan{position:absolute;left:0;right:0;height:1px;background:#d2ffaa22;top:0;animation:r2-scan 9s linear infinite;pointer-events:none}.r2-console{display:flex;flex-direction:column;min-height:0}.r2-section-label{display:flex;justify-content:space-between;align-items:center;font-size:13px;margin-bottom:16px}.r2-section-label small{font-size:8px;color:#788170}.r2-line h2{font-size:21px;margin:4px 0;font-weight:500}.r2-line small{color:#96a18e;font-size:9px}.r2-icon{background:#292e27;min-width:42px;height:42px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center}.r2-icon:hover{background:#425039}.r2-levels{display:flex;align-items:center;gap:4px;height:65px;margin:12px 0}.r2-levels i{flex:1;background:#bafc72;transform-origin:center;animation:r2-meter 1s ease-in-out infinite alternate;opacity:.85}.r2-levels i:nth-child(5n){background:#ff987f}.r2-levels.paused i{animation-play-state:paused;transform:scaleY(.08);opacity:.3}.r2-volume{display:flex;gap:18px;align-items:center}.r2-volume>strong{font-size:44px;font-weight:400;font-variant-numeric:tabular-nums;line-height:1}.r2-volume strong small{font-size:16px;color:#9daa92;margin-left:4px}.r2-volume>span{font-size:12px;color:#e1e8da}.r2-volume span small{display:block;font-size:8px;color:#818e77;margin-top:5px}.r2 input[type=range]{appearance:none;display:block;width:100%;height:5px;margin:19px 0;cursor:pointer;border-radius:0}.r2 input[type=range]::-webkit-slider-thumb{appearance:none;width:15px;height:23px;border-radius:3px;background:#e3ffd0;box-shadow:0 0 15px #bafc7233;border:2px solid #151715}.r2-lights,.r2-curtains{border-top:1px solid #343732;padding-top:16px;margin-top:auto}.r2-lights .r2-line>span,.r2-curtains .r2-line>span{display:flex;align-items:center;gap:10px;font-size:12px}.r2-line>strong{font-size:22px;font-weight:400}.r2-line>strong small{margin-left:3px}.r2-scenes{display:grid;grid-template-columns:130px repeat(4,minmax(0,1fr));gap:12px;align-items:center;padding:16px 0;border-top:1px solid #343732}.r2-scene-title h2{font-size:16px;margin:6px 0}.r2-scenes button{min-height:74px;padding:13px;background:#232720;border:1px solid #353d30;display:flex;align-items:center;gap:12px;text-align:left;border-radius:6px;transition:background .3s,transform .25s,border-color .3s}.r2-scenes button:hover{transform:translateY(-3px);border-color:#a5bf8a}.r2-scenes button.active{background:#bafc72;color:#18280a;border-color:#bafc72}.r2-scenes button>span{flex:1;font-size:13px}.r2-scenes button small{display:block;font-size:8px;margin-top:5px;opacity:.65}.r2-footer{font-size:8px;color:#849079}.r2-footer b{font-weight:400;margin-left:12px}.r2-footer i{margin-right:6px}.r2-screen{height:180px;background:#242c22;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;overflow:hidden;margin:10px 0}.r2-screen>.v-icon{color:var(--accent)}.r2-screen span{font-size:9px;color:#9dac91}.r2-screen i{position:absolute;bottom:0;height:2px;background:var(--accent);width:35%;animation:r2-signal 3s ease-in-out infinite}.r2-select{display:flex;align-items:center;gap:12px;font-size:12px;margin-bottom:16px}.r2 select{flex:1;min-width:0;background:#292e27;color:#e6eddf;border:1px solid #48533f;padding:10px}.r2-climate{padding:0 0 10px}.r2-dial{width:170px;height:170px;border-radius:50%;margin:0 auto 8px;padding:5px;background:conic-gradient(from 225deg,#bafc72 0deg,var(--accent) var(--angle),#394132 var(--angle),#394132 270deg,transparent 270deg);transition:background .3s}.r2-dial>div{background:#151715;border-radius:50%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center}.r2-dial small{font-size:9px;color:#94a487}.r2-dial strong{font-size:42px;font-weight:400}.r2-dial sup{font-size:20px}.r2-dial span{font-size:11px;color:var(--accent)}.r2-temp{display:flex;align-items:center;justify-content:center;gap:24px}.r2-temp>span{font-size:10px;color:#a5b398}.r2-notice{position:fixed;bottom:26px;left:50%;transform:translateX(-50%);background:#bafc72;color:#16220d;padding:13px 22px;display:flex;align-items:center;gap:10px;font-size:13px;border-radius:5px;z-index:1000;box-shadow:0 8px 30px #0005}.r2-toast-enter-active,.r2-toast-leave-active{transition:opacity .25s,translate .25s}.r2-toast-enter-from,.r2-toast-leave-to{opacity:0;translate:0 10px}@keyframes r2-meter{from{transform:scaleY(.2)}to{transform:scaleY(1)}}@keyframes r2-enter{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}@keyframes r2-pulse{50%{box-shadow:0 0 0 14px #c0ff7600}}@keyframes r2-scan{to{top:100%}}@keyframes r2-signal{50%{transform:translateX(80%)}0%,100%{transform:translateX(-80%)}}\n@media(min-width:761px){.r2{height:100dvh;min-height:680px}}@media(min-width:761px) and (max-height:780px){.r2{padding:14px 24px;gap:12px}.r2-title h1{font-size:25px}.r2-scenes{padding:10px 0}.r2-scenes button{min-height:62px}.r2-visual{min-height:280px}.r2-levels{height:45px}.r2-screen{height:130px}.r2-dial{width:135px;height:135px}.r2-lights,.r2-curtains{padding-top:10px}.r2-section-label{margin-bottom:10px}}\n@media(max-width:1050px){.r2{padding:18px 22px}.r2-main{grid-template-columns:minmax(0,1.2fr) minmax(260px,1fr);gap:20px}.r2-scenes{grid-template-columns:repeat(4,minmax(0,1fr))}.r2-scene-title{display:none}.r2-scenes button{gap:7px;padding:10px}.r2-visual h2{font-size:23px}.r2-metrics{gap:16px}}\n@media(max-width:760px){.r2{padding:18px;gap:18px}.r2-title h1{font-size:25px}.r2-status time{margin-left:4px}.r2-tabnote{display:none}.r2-tabs{gap:4px}.r2-tabs button{flex:1;padding:10px 6px;justify-content:center}.r2-main{grid-template-columns:1fr;gap:22px}.r2-visual{height:360px;min-height:0}.r2-scenes{grid-template-columns:1fr 1fr}.r2-scenes button{min-height:72px}.r2-footer>span:last-child{display:none}.r2-hotspot.h2{top:37%;right:5%}.r2-visual-bottom{left:18px;right:18px}.r2-lights,.r2-curtains{margin-top:12px}.r2-notice{max-width:calc(100vw - 32px);white-space:nowrap}.r2-screen{height:180px}}\n.r2-stage{display:grid;flex:1;min-height:0;isolation:isolate}\n.r2-stage>.r2-main{grid-area:1 / 1}\n.r2-head,.r2-title,.r2-tabs,.r2-scenes,.r2-footer{flex-shrink:0}\n.r2-console{display:grid;grid-template-rows:auto minmax(0,1fr) auto auto;gap:10px}\n.r2-section-label{margin:0}\n.r2-lights,.r2-curtains{margin:0;padding-top:10px}\n.r2-console input[type=range]{margin:14px 0 16px}\n.r2-climate{display:flex;align-items:center;justify-content:space-evenly;gap:12px;padding:0;min-height:0}\n.r2-dial{flex-shrink:0;width:132px;height:132px;margin:0}\n.r2-temp{flex-direction:column;gap:6px}\n.r2-audio,.r2-video{min-height:0}\n.r2-video{display:grid;grid-template-rows:auto minmax(56px,1fr) 42px;gap:6px;height:100%;overflow:hidden}\n.r2-video .r2-screen{height:auto;min-height:0;margin:0}\n.r2-select{height:42px;min-height:42px;margin:0;overflow:hidden}\n.r2-select select{height:42px;min-height:42px;max-height:42px;padding:0 12px}\n.r2-screen>.v-icon{position:static;bottom:auto;width:auto;height:auto;background:transparent;animation:none}\n.r2-screen>.r2-signal{position:absolute;bottom:0;width:35%;height:2px;background:var(--accent);animation:r2-signal 3s ease-in-out infinite}\n@media(min-width:761px){.r2-stage .r2-visual{min-height:0}.r2{min-height:700px}.r2-console{gap:8px}.r2-level