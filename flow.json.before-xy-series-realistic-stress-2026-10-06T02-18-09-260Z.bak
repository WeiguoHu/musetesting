    {
        "id": "5ad8d2331b9b5b61",
        "type": "ui-control-panel",
        "z": "78cb8aa58273455c",
        "group": "",
        "page": "cc254cb4d90d2984",
        "ui": "",
        "name": "XY Series Local Test",
        "order": 0,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n  <main class=\"xy-test\">\n    <header class=\"xy-test__header\">\n      <div><small>LOCAL AUTOMATOR VALIDATION</small><h1>XY-series telemetry</h1></div>\n      <div class=\"xy-test__status\"><span :class=\"{active: spectrumA.length}\"></span>4 x 8192 points / 10 Hz</div>\n    </header>\n    <section class=\"xy-test__grid\">\n      <article class=\"xy-card\">\n        <div class=\"xy-card__title\"><div><small>STREAM A / FREQUENCY / LEVEL</small><h2>Live spectrum A</h2></div><strong>8192</strong></div>\n        <canvas id=\"xy-spectrum-a\" ref=\"spectrumCanvasA\" :data-points=\"spectrumA\" aria-label=\"实时频谱 A\"></canvas>\n        <div class=\"xy-card__scale\"><span>20 Hz</span><span>20 kHz</span></div>\n      </article>\n      <article class=\"xy-card\">\n        <div class=\"xy-card__title\"><div><small>STREAM B / FREQUENCY / LEVEL</small><h2>Live spectrum B</h2></div><strong>8192</strong></div>\n        <canvas id=\"xy-spectrum-b\" ref=\"spectrumCanvasB\" :data-points=\"spectrumB\" aria-label=\"实时频谱 B\"></canvas>\n        <div class=\"xy-card__scale\"><span>20 Hz</span><span>20 kHz</span></div>\n      </article>\n      <article class=\"xy-card\">\n        <div class=\"xy-card__title\"><div><small>STREAM C / FREQUENCY / LEVEL</small><h2>Live spectrum C</h2></div><strong>8192</strong></div>\n        <canvas id=\"xy-spectrum-c\" ref=\"spectrumCanvasC\" :data-points=\"spectrumC\" aria-label=\"实时频谱 C\"></canvas>\n        <div class=\"xy-card__scale\"><span>20 Hz</span><span>20 kHz</span></div>\n      </article>\n      <article class=\"xy-card\">\n        <div class=\"xy-card__title\"><div><small>STREAM D / FREQUENCY / LEVEL</small><h2>Live spectrum D</h2></div><strong>8192</strong></div>\n        <canvas id=\"xy-spectrum-d\" ref=\"spectrumCanvasD\" :data-points=\"spectrumD\" aria-label=\"实时频谱 D\"></canvas>\n        <div class=\"xy-card__scale\"><span>20 Hz</span><span>20 kHz</span></div>\n      </article>\n      <article class=\"xy-card\">\n        <div class=\"xy-card__title\"><div><small>LONGITUDE / LATITUDE</small><h2>Live locations</h2></div><strong>4</strong></div>\n        <div id=\"xy-map\" class=\"xy-map\" :data-coordinates=\"locations\" aria-label=\"实时位置\">\n          <span class=\"xy-map__grid xy-map__grid--x\"></span><span class=\"xy-map__grid xy-map__grid--y\"></span>\n          <span v-for=\"(point, index) in locations\" :key=\"index\" class=\"xy-map__point\" :style=\"mapPointStyle(point)\" :title=\"pointLabel(point, index)\"><b>{{ index + 1 }}</b></span>\n          <span v-if=\"!locations.length\" class=\"xy-map__empty\">Waiting for coordinates</span>\n        </div>\n        <div class=\"xy-card__scale\"><span>West</span><span>East</span></div>\n      </article>\n    </section>\n  </main>\n</template>\n\n<script>\nexport default {\n  data () { return { spectrumA: [], spectrumB: [], spectrumC: [], spectrumD: [], locations: [], resizeObservers: [] } },\n  watch: {\n    spectrumA: { deep: true, handler () { this.drawSpectrum('spectrumA', 'spectrumCanvasA') } },\n    spectrumB: { deep: true, handler () { this.drawSpectrum('spectrumB', 'spectrumCanvasB') } },\n    spectrumC: { deep: true, handler () { this.drawSpectrum('spectrumC', 'spectrumCanvasC') } },\n    spectrumD: { deep: true, handler () { this.drawSpectrum('spectrumD', 'spectrumCanvasD') } }\n  },\n  mounted () {\n    const canvases = [['spectrumA', 'spectrumCanvasA'], ['spectrumB', 'spectrumCanvasB'], ['spectrumC', 'spectrumCanvasC'], ['spectrumD', 'spectrumCanvasD']]\n    for (const [field, ref] of canvases) {\n      const observer = new ResizeObserver(() => this.drawSpectrum(field, ref))\n      observer.observe(this.$refs[ref]); this.resizeObservers.push(observer)\n    }\n    this.drawSpectrum('spectrumA', 'spectrumCanvasA'); this.drawSpectrum('spectrumB', 'spectrumCanvasB')\n    this.drawSpectrum('spectrumC', 'spectrumCanvasC'); this.drawSpectrum('spectrumD', 'spectrumCanvasD')\n  },\n  unmounted () { this.resizeObservers.forEach(observer => observer.disconnect()) },\n  methods: {\n    drawSpectrum (field, canvasRef) {\n      const canvas = this.$refs[canvasRef]\n      if (!canvas) return\n      const rect = canvas.getBoundingClientRect(); const ratio = window.devicePixelRatio || 1\n      canvas.width = Math.max(1, Math.round(rect.width * ratio)); canvas.height = Math.max(1, Math.round(rect.height * ratio))\n      const context = canvas.getContext('2d'); context.setTransform(ratio, 0, 0, ratio, 0, 0)\n      context.clearRect(0, 0, rect.width, rect.height); context.strokeStyle = '#d7e5dc'; context.lineWidth = 1\n      for (let row = 1; row < 5; row++) { const y = rect.height * row / 5; context.beginPath(); context.moveTo(0, y); context.lineTo(rect.width, y); context.stroke() }\n      const points = this[field]\n      const values = points.map(point => Number(point[1])).filter(Number.isFinite)\n      if (!values.length) return\n      const min = Math.min(...values); const max = Math.max(...values, min + 1)\n      context.strokeStyle = '#147d70'; context.lineWidth = 2; context.beginPath()\n      points.forEach((point, index) => {\n        const x = points.length === 1 ? rect.width / 2 : index * rect.width / (points.length - 1)\n        const y = rect.height - ((Number(point[1]) - min) / (max - min)) * rect.height\n        if (index === 0) context.moveTo(x, y); else context.lineTo(x, y)\n      })\n      context.stroke()\n    },\n    mapPointStyle (point) {\n      const longitude = Number(point?.[0]); const latitude = Number(point?.[1])\n      const x = Number.isFinite(longitude) ? Math.max(3, Math.min(97, ((longitude + 180) / 360) * 100)) : 50\n      const y = Number.isFinite(latitude) ? Math.max(3, Math.min(97, (1 - ((latitude + 90) / 180)) * 100)) : 50\n      return { left: x + '%', top: y + '%' }\n    },\n    pointLabel (point, index) { return `Point ${index + 1}: ${point?.[0]}, ${point?.[1]}` }\n  }\n}\n</script>\n\n<style>\n.xy-test{min-height:100dvh;padding:28px;background:#f3f7f4;color:#1e3029;font-family:Inter,system-ui,sans-serif;box-sizing:border-box}.xy-test *{box-sizing:border-box;letter-spacing:0}.xy-test__header{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;max-width:1260px;margin:0 auto 22px}.xy-test__header small,.xy-card__title small{font-size:10px;letter-spacing:.08em;color:#678276}.xy-test h1,.xy-test h2{margin:0;font-weight:600}.xy-test h1{font-size:28px;margin-top:5px}.xy-test h2{font-size:17px;margin-top:5px}.xy-test__status{font-size:12px;color:#678276;display:flex;align-items:center;gap:7px}.xy-test__status>span{width:8px;height:8px;border-radius:50%;background:#aabbb0}.xy-test__status>span.active{background:#147d70}.xy-test__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;max-width:1260px;margin:0 auto}.xy-card{background:#fff;border:1px solid #d6e2da;border-radius:8px;padding:20px;min-width:0;box-shadow:0 8px 24px #1843310b}.xy-card__title{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:14px}.xy-card__title strong{font-size:24px;color:#147d70}.xy-card__scale{display:flex;justify-content:space-between;color:#83968b;font-size:10px;margin-top:8px}.xy-card canvas{display:block;width:100%;height:220px;border:1px solid #e1ebe4;background:#f7fbf8}.xy-map{position:relative;height:220px;overflow:hidden;border:1px solid #d6e2da;background:linear-gradient(135deg,#eff7f1,#d9eee2)}.xy-map__grid{position:absolute;inset:0;opacity:.5;pointer-events:none}.xy-map__grid--x{background:repeating-linear-gradient(0deg,transparent 0 39px,#a5c8b3 40px 41px)}.xy-map__grid--y{background:repeating-linear-gradient(90deg,transparent 0 59px,#a5c8b3 60px 61px)}.xy-map__point{position:absolute;display:grid;place-items:center;width:26px;height:26px;transform:translate(-50%,-50%);border:3px solid #fff;border-radius:50%;background:#147d70;color:#fff;box-shadow:0 3px 10px #18433133}.xy-map__point b{font-size:10px}.xy-map__empty{position:absolute;inset:0;display:grid;place-items:center;color:#769184;font-size:12px}@media(max-width:760px){.xy-test{padding:18px}.xy-test__header{align-items:flex-start;flex-direction:column}.xy-test__grid{grid-template-columns:1fr}.xy-card canvas,.xy-map{height:260px}}\n</style>\n",
        "visualBindings": "{\"control.xySpectrumA\":{\"locator\":\"name:c664c8a450ce28faf89b\",\"adapter\":\"xy-series\",\"type\":\"xy-series\",\"label\":\"实时频谱 A\",\"mode\":\"read\",\"model\":\"spectrumA\",\"device\":\"Meter Validation\",\"writePath\":\"\",\"readPath\":\"//seriesAFrame\",\"readMeta\":{\"kind\":\"param\",\"type\":\"string\",\"access\":\"ro\",\"onebased\":false,\"controlType\":\"xy-series\",\"controlSchemaVersion\":1,\"xySeries\":{\"streamId\":\"validation/spectrum-a\",\"eventPath\":\"//seriesAFrame\",\"manifestPath\":\"//seriesAManifest\"}}},\"control.xySpectrumB\":{\"locator\":\"name:f562cd1509831cf2e138\",\"adapter\":\"xy-series\",\"type\":\"xy-series\",\"label\":\"实时频谱 B\",\"mode\":\"read\",\"model\":\"spectrumB\",\"device\":\"Meter Validation\",\"writePath\":\"\",\"readPath\":\"//seriesBFrame\",\"readMeta\":{\"kind\":\"param\",\"type\":\"string\",\"access\":\"ro\",\"onebased\":false,\"controlType\":\"xy-series\",\"controlSchemaVersion\":1,\"xySeries\":{\"streamId\":\"validation/spectrum-b\",\"eventPath\":\"//seriesBFrame\",\"manifestPath\":\"//seriesBManifest\"}}},\"control.xySpectrumC\":{\"locator\":\"name:7a4463318aca023a0243\",\"adapter\":\"xy-series\",\"type\":\"xy-series\",\"label\":\"实时频谱 C\",\"mode\":\"read\",\"model\":\"spectrumC\",\"device\":\"Meter Validation\",\"writePath\":\"\",\"readPath\":\"//seriesCFrame\",\"readMeta\":{\"kind\":\"param\",\"type\":\"string\",\"access\":\"ro\",\"onebased\":false,\"controlType\":\"xy-series\",\"controlSchemaVersion\":1,\"xySeries\":{\"streamId\":\"validation/spectrum-c\",\"eventPath\":\"//seriesCFrame\",\"manifestPath\":\"//seriesCManifest\"}}},\"control.xySpectrumD\":{\"locator\":\"name:0df7e09542061324c93f\",\"adapter\":\"xy-series\",\"type\":\"xy-series\",\"label\":\"实时频谱 D\",\"mode\":\"read\",\"model\":\"spectrumD\",\"device\":\"Meter Validation\",\"writePath\":\"\",\"readPath\":\"//seriesDFrame\",\"readMeta\":{\"kind\":\"param\",\"type\":\"string\",\"access\":\"ro\",\"onebased\":false,\"controlType\":\"xy-series\",\"controlSchemaVersion\":1,\"xySeries\":{\"streamId\":\"validation/spectrum-d\",\"eventPath\":\"//seriesDFrame\",\"manifestPath\":\"//seriesDManifest\"}}},\"control.xyLocations\":{\"locator\":\"name:29e312bfa63cfa7082ab\",\"adapter\":\"xy-series\",\"type\":\"xy-series\",\"label\":\"实时位置\",\"mode\":\"read\",\"model\":\"locations\",\"device\":\"Meter Validation\",\"writePath\":\"\",\"readPath\":\"//coordinatesFrame\",\"readMeta\":{\"kind\":\"param\",\"type\":\"string\",\"access\":\"ro\",\"onebased\":false,\"controlType\":\"xy-series\",\"controlSchemaVersion\":1,\"xySeries\":{\"streamId\":\"validation/coordinates\",\"eventPath\":\"//coordinatesFrame\",\"manifestPath\":\"//coordinatesManifest\"}}}}",
        "boundRoom": "xy-series-test",
        "nativeBridge": false,
        "secureCookie": false,
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "widget:page",
        "className": "",
