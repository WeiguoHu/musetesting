    },
    {
        "id": "959d68914a357b44",
        "type": "comment",
        "z": "bb1fe29e5ba07023",
        "name": "An IO operates much like a relay when configured as an output and can be turned on and off",
        "info": "",
        "x": 440,
        "y": 900,
        "wires": []
    },
    {
        "id": "c9c06137f5116420",
        "type": "comment",
        "z": "bb1fe29e5ba07023",
        "name": "When configured as an Analog input an IO will detect and report voltage changes between 0V and 12V",
        "info": "",
        "x": 470,
        "y": 360,
        "wires": []
    },
    {
        "id": "176399972d6380f0",
        "type": "comment",
        "z": "bb1fe29e5ba07023",
        "name": "When configured as a Digital input an IO will detect and report voltage changes between 0V and 12V that cross a configured high or low threshold",
        "info": "",
        "x": 610,
        "y": 540,
        "wires": []
    },
    {
        "id": "7ba47f16de163958",
        "type": "comment",
        "z": "bb1fe29e5ba07023",
        "name": "When configured as a Digital Output an IO will report changes in its state as determined by the running program",
        "info": "",
        "x": 500,
        "y": 720,
        "wires": []
    },
