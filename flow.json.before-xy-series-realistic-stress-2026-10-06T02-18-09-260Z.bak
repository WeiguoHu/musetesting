    {
        "id": "0a6eebefec3658b0",
        "type": "function",
        "z": "987aea556f99bc0c",
        "g": "dfb48f53edaf2515",
        "name": "veryControlType-ConcaString",
        "func": "let arr = global.get(\"currentControl\");\n\nif (Array.isArray(arr) && arr.length >= 2) {\n    if (arr[0].toUpperCase() === \"T\" ) {\n        msg.payload = `<${arr[0]}&${arr[1]}>`;\n    } else {\n        msg.payload = \"\";\n    }\n} else {\n    msg.payload = \"\";\n}\n\n// 正确写法：用 global.set 赋值\nglobal.set(\"buttonStatus\", msg.payload);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 1740,
        "wires": [
            [
                "5a7424e6ceba6040"
            ]
        ]
    },
    {
        "id": "55439bd7411d2b3f",
        "type": "function",
        "z": "987aea556f99bc0c",
        "g": "dfb48f53edaf2515",
        "name": "insertChar",
        "func": "let str = global.get(\"buttonStatus\");\nlet num = 0; // 要插入的数字\nlet pos = str.lastIndexOf(\">\");\nif (pos > 0) {\n    // 把字符串分成两部分：> 前面的 和 > 后面的\n    let before = str.substring(0, pos);\n    let after = str.substring(pos);\n    msg.payload = before + \"&\" + num + after;\n} else {\n    // 如果没找到 >，不变\n    msg.payload = str;\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1290,
        "y": 1720,
