        "g": "f8a1bdabc4d4adae",
        "name": "purseStringToArray",
        "rules": [
            {
                "t": "set",
                "p": "payload",
                "pt": "msg",
                "to": "$map(\t  $split(\t    ( $substring($trim(payload),0,1) = '<' and $substring($trim(payload), $length($trim(payload))-1,1) = '>' )\t      ? $substring($trim(payload), 1, $length($trim(payload)) - 2)\t      : $trim(payload),\t    \"&\"\t  ),\t  function($v){ $trim($v) }\t)",
                "tot": "jsonata"
            }
        ],
